[Unit]
Description=Ti-Scale reviewed real-candidate Linux typed transport broker
After=local-fs.target ti-scale-reviewed-candidate-linux-adapter.service
Requires=ti-scale-reviewed-candidate-linux-adapter.service
Before=ti-scale.service
ConditionPathExists=/etc/ti-scale/reviewed-real-candidate-linux-broker.env

[Service]
Type=simple
User=ti-scale
Group=ti-scale
EnvironmentFile=/etc/ti-scale/reviewed-real-candidate-linux-broker.env
ExecStart=/usr/local/libexec/ti-scale/reviewed-real-candidate-linux-broker
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s
RuntimeDirectory=ti-scale-candidate-linux-reviewed
RuntimeDirectoryMode=0750
StateDirectory=ti-scale-candidate-linux-reviewed
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/ti-scale/data
ReadWritePaths=/run/ti-scale-candidate-linux-reviewed
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=32
MemoryMax=256M

[Install]
WantedBy=multi-user.target
