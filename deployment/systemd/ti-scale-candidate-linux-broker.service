[Unit]
Description=Ti-Scale disposable candidate Linux typed transport broker
After=local-fs.target
Before=ti-scale.service
ConditionPathExists=/etc/ti-scale/candidate-linux-broker.env

[Service]
Type=simple
User=ti-scale
Group=ti-scale
EnvironmentFile=/etc/ti-scale/candidate-linux-broker.env
ExecStart=/usr/local/bin/bun /usr/local/libexec/ti-scale/disposable-candidate-linux-broker.js
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s
RuntimeDirectory=ti-scale-candidate-linux
RuntimeDirectoryMode=0750
StateDirectory=ti-scale-candidate-linux
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/ti-scale-candidate-linux /var/lib/ti-scale-candidate-linux
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=32
MemoryMax=256M

[Install]
WantedBy=multi-user.target
