# Install as /etc/ti-scale/research-readiness.env only when the reviewed
# descriptor and the systemd credential named `research-integrity-key` are
# present. Omitting this file keeps Ti-Scale available and reports Research as
# unavailable.
TI_SCALE_RESEARCH_READINESS_TRUST_ROOT=/etc/ti-scale/runtime
TI_SCALE_RESEARCH_READINESS_DESCRIPTOR_PATH=/etc/ti-scale/runtime/research-readiness-probe.v1.json
TI_SCALE_RESEARCH_READINESS_DESCRIPTOR_SHA256=f831598d4902c8b5652c698cff7fbd413ba3811b3a94c49f30513d565c389285
TI_SCALE_RESEARCH_READINESS_TEMP_ROOT=/run/ti-scale/research-readiness
