# Ti-Scale keeps server and browser configuration in a dedicated namespace.
TI_SCALE_HOST=127.0.0.1
TI_SCALE_PORT=3132
TI_SCALE_DATABASE_PATH=./data/ti-scale.sqlite
# Optional local Obsidian-compatible Vault sandbox. Persisted, audited Vault
# connections (for example, a Ti-Scale-Brain child directory) live beneath it.
# TI_SCALE_VAULT_ROOT=/var/lib/ti-scale/vaults
TI_SCALE_KILL_SWITCH=false
TI_SCALE_PREVIEW=true
TI_SCALE_SERVE_STATIC=true

# Optional immutable static-release root. The server verifies and pins its
# active release manifest once at startup instead of serving mutable files.
# TI_SCALE_STATIC_RELEASE_ROOT=/var/lib/ti-scale/static-releases

# Optional absolute directory containing one local, review-only 3D candidate
# manifest and its content-addressed assets. This exposes /motion-lab/candidates
# after authentication; it does not approve, promote, or copy the candidate.
# TI_SCALE_MOTION_REVIEW_ROOT=/var/lib/ti-scale/model-review/candidate-01

# Optional absolute, non-symlink JSON document containing exact reviewed
# version/help probes for local tools already declared by the runtime manifest.
# A ready receipt additionally requires technical network/write isolation and
# an unchanged executable identity. The registry never adds tools or grants
# mission execution.
# TI_SCALE_TOOL_BINDING_REGISTRY_PATH=/etc/ti-scale/tool-bindings.v1.json

# Optional immutable runtime capability source. All three values are required
# together; a partial reference fails startup. The document supplies reviewed
# definitions only. Agents, MCP servers, providers, and tools remain offline
# until their separate live attestations and execution boundaries pass.
# TI_SCALE_TRUSTED_RUNTIME_CONFIG_ROOT=/etc/ti-scale/runtime
# TI_SCALE_RUNTIME_SOURCE_MANIFEST_PATH=/etc/ti-scale/runtime/runtime-source-manifests.v1.json
# TI_SCALE_RUNTIME_SOURCE_MANIFEST_SHA256=<reviewed lowercase sha256>

# Optional exact-step Guided local-tool runtime. Configure all seven values or
# none. These files are loaded through one pinned, non-writable trust root;
# live installation, isolated probe, adapter, workspace, result, and
# cancellation receipts must still pass before any tool appears available.
# TI_SCALE_LOCAL_TOOL_TRUSTED_CONFIG_ROOT=/etc/ti-scale/runtime
# TI_SCALE_LOCAL_TOOL_CAPABILITY_MANIFEST_PATH=/etc/ti-scale/runtime/local-tool-capabilities.v1.json
# TI_SCALE_LOCAL_TOOL_CAPABILITY_MANIFEST_SHA256=<reviewed lowercase sha256>
# TI_SCALE_LOCAL_TOOL_PROBE_SANDBOX_PATH=/etc/ti-scale/runtime/bubblewrap-probe-sandbox.v1.json
# TI_SCALE_LOCAL_TOOL_PROBE_SANDBOX_SHA256=<reviewed lowercase sha256>
# TI_SCALE_LOCAL_TOOL_WORKSPACE_MAPPINGS_PATH=/etc/ti-scale/runtime/engagement-workspace-mappings.v1.json
# TI_SCALE_LOCAL_TOOL_WORKSPACE_MAPPINGS_SHA256=<reviewed lowercase sha256>

# Optional local Research Lab readiness boundary. Configure all four values or
# none. The descriptor pins bubblewrap, prlimit, the evaluator executable, the
# fixed worker source, time limits, resource limits, and receipt lifetime.
# Startup separately proves a dirty-to-recreated synthetic fixture and the
# exact single-use worker process that later receives an admitted experiment.
# Configuration presence alone never makes Research ready.
# TI_SCALE_RESEARCH_READINESS_TRUST_ROOT=/etc/ti-scale/runtime
# TI_SCALE_RESEARCH_READINESS_DESCRIPTOR_PATH=/etc/ti-scale/runtime/research-readiness-probe.v1.json
# TI_SCALE_RESEARCH_READINESS_DESCRIPTOR_SHA256=f831598d4902c8b5652c698cff7fbd413ba3811b3a94c49f30513d565c389285
# TI_SCALE_RESEARCH_READINESS_TEMP_ROOT=/run/ti-scale/research-readiness
# Production normally discovers the systemd credential named
# `research-integrity-key` through CREDENTIALS_DIRECTORY. This explicit
# private-file override is for an equivalent reviewed service manager.
# Domain-separated derived keys sign lab, worker, admission, and evaluator
# receipts; none is mounted into a fixture or worker.
# TI_SCALE_RESEARCH_INTEGRITY_HMAC_KEY_FILE=/run/credentials/ti-scale.service/research-integrity-key
# Inline test key (NODE_ENV=test only):
# TI_SCALE_RESEARCH_INTEGRITY_HMAC_KEY=<test-only private key>

# Opt-in only. Uses the same pinned bubblewrap and workspace documents above;
# startup still marks each SMB/LDAP/RPC/NetExec binding unavailable unless its
# exact executable, isolated target-free probe, and adapter checks pass.
# TI_SCALE_WINDOWS_IDENTITY_ENABLED=false
# Optional private root containing one directory per opaque bundle ID. Each
# bundle uses fixed 0600 files (samba-auth, username, password, or
# ldap-bind-identity); values never enter HTTP, logs, or browser storage.
# TI_SCALE_WINDOWS_IDENTITY_CREDENTIAL_ROOT=/run/credentials/ti-scale/windows-identity

# Generate a private value of at least 24 bytes. Never expose it through a
# VITE_ variable or commit the real value.
TI_SCALE_OPERATOR_TOKEN=
# Preferred for service managers: an absolute private regular file (mode 0600).
TI_SCALE_OPERATOR_TOKEN_FILE=
TI_SCALE_OPERATOR_ID=local-operator

# Set true when Ti-Scale is served through HTTPS.
TI_SCALE_SECURE_COOKIES=false

# Canonical private provider-configuration directory. System → Connections
# writes the OpenRouter configuration and credential here as service-owned
# mode-0600 files. The directory itself is mode 0700.
TI_SCALE_PROVIDER_CONFIG_ROOT=/var/lib/ti-scale/provider-config

# Legacy file-based OpenRouter discovery remains available only when no
# canonical System → Connections record exists. A raw OPENROUTER_API_KEY
# environment value is deliberately unsupported.
TI_SCALE_OPENROUTER_GUIDED_ENABLED=false
# TI_SCALE_OPENROUTER_CREDENTIAL_PATH=/run/credentials/ti-scale.service/openrouter-api-key
# TI_SCALE_OPENROUTER_MODEL=openai/gpt-5.2

# Browser API origin used by Vite during development.
VITE_TI_SCALE_API_ORIGIN=http://127.0.0.1:43141
