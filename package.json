{
  "name": "@ti-scale/platform",
  "version": "0.1.0-preview.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "server:dev": "TI_SCALE_PORT=43141 TI_SCALE_SERVE_STATIC=false bun run server/index.ts",
    "client:dev": "vite --host 127.0.0.1 --port 43140",
    "server": "TI_SCALE_PORT=${TI_SCALE_PORT:-3132} TI_SCALE_SERVE_STATIC=true bun run server/index.ts",
    "build": "vite build",
    "preview": "bun run build && bun run server",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "bun test tests/unit server src/lib",
    "test:process-restart": "bun test server/app/__tests__/StandaloneProcessRestart.test.ts",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:accessibility": "playwright test tests/e2e/accessibility-axe.spec.ts",
    "test:e2e:release-local": "TI_SCALE_E2E_PROFILE=release TI_SCALE_E2E_REQUIRE_API=1 TI_SCALE_E2E_ENFORCE_MANIFEST=1 TI_SCALE_E2E_SERVER_MODE=playwright-managed-static TI_SCALE_E2E_EXTERNAL_SERVERS=false TI_SCALE_E2E_BASE_URL=http://127.0.0.1:43140 TI_SCALE_E2E_API_URL=http://127.0.0.1:43140 playwright test",
    "test:e2e:headed": "bun run build && playwright test --headed",
    "test:interaction-manifest": "bun test tests/unit/interaction-manifest",
    "isolation:verify": "bun run scripts/verify-isolation.ts",
    "release:attest": "bun run build && bun run scripts/release-attestation.ts",
    "release:attest:local": "bun run build && bun run scripts/release-attestation.ts --allow-ineligible",
    "release:static:stage": "bun run server/static-release/cli.ts stage",
    "release:static:verify": "bun run server/static-release/cli.ts verify",
    "release:static:activate": "bun run server/static-release/cli.ts activate",
    "release:static:pin": "bun run server/static-release/cli.ts pin",
    "release:static:rollback": "bun run server/static-release/cli.ts rollback",
    "db:migrate": "bun run server/db/cli.ts migrate",
    "db:verify": "bun run server/migration/cli.ts verify",
    "db:backup": "bun run server/migration/cli.ts backup",
    "db:restore": "bun run server/migration/cli.ts restore",
    "db:migrate:historical": "bun run server/migration/cli.ts migrate",
    "db:reconcile": "bun run server/migration/cli.ts reconcile",
    "brain:import-obsidian": "bun run server/vault/cli.ts import",
    "brain:export-obsidian": "bun run server/vault/cli.ts export",
    "brain:project-imported": "bun run server/migration/cli.ts project-vault",
    "brain:sync-verify": "bun run server/vault/cli.ts sync-verify",
    "check": "bun run isolation:verify && bun run typecheck && bun run typecheck:e2e && bun run test && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "11.10.0",
    "express": "5.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.12.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
}
